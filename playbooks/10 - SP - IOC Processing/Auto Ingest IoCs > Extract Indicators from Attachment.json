                "total_iocs": "{% set ns = namespace(total_feeds=0) %}\n\n{% for item in vars.steps.Extract_IoCs_From_File %}\n    {% for indicator_type, indicators in item.data.items() %}\n        {% set ns.total_feeds = ns.total_feeds + (indicators | length) %}\n    {% endfor %}\n{% endfor %}\n\n{{ ns.total_feeds }}",
                "fetched_indicators": "{% set ns = namespace(merged={}) %}\n\n{% for item in vars.steps.Extract_IoCs_From_File | default([]) %}\n    {% for indicator_type in item.data | default({}) %}\n        {% set indicators = item.data[indicator_type] | default([]) %}\n\n        {% if indicator_type not in ns.merged %}\n            {% set _ = ns.merged.update({ indicator_type: [] }) %}\n        {% endif %}\n\n        {% for ioc in indicators %}\n            {% if ioc not in ns.merged[indicator_type] %}\n                {% set _ = ns.merged[indicator_type].append(ioc) %}\n            {% endif %}\n        {% endfor %}\n\n    {% endfor %}\n{% endfor %}\n\n{{ ns.merged }}"
            },
            "status": null,
